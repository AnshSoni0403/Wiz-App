{
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist-vercel",
  "functions": { "api/v1/[...path].js": { "maxDuration": 120 } },
  "redirects": [{ "source": "/", "destination": "/wizz-app/", "permanent": false }],
  "rewrites": [
    { "source": "/wizz-app", "destination": "/wizz-app/index.html" },
    { "source": "/wizz-app/:path*", "destination": "/wizz-app/index.html" }
  ]
}
